network unknown {
}
variable Burglary {
  type discrete [ 2 ] { True, False };
}
variable Earthquake {
  type discrete [ 2 ] { True, False };
}
variable Alarm {
  type discrete [ 3 ] { Low, Medium, High };
}
variable JohnCalls {
  type discrete [ 2 ] { True, False };
}
variable MaryCalls {
  type discrete [ 3 ] { Never, Sometimes, Always };
}
probability ( Burglary ) {
  table 0.01, 0.99;
}
probability ( Earthquake ) {
  table 0.02, 0.98;
}
probability ( Alarm | Burglary, Earthquake ) {
  (True, True) 0.3, 0.4, 0.3;
  (False, True) 0.2, 0.5, 0.3;
  (True, False) 0.1, 0.6, 0.3;
  (False, False) 0.05, 0.75, 0.2;
}
probability ( JohnCalls | Alarm ) {
  (Low) 0.1, 0.9;
  (Medium) 0.5, 0.5;
  (High) 0.9, 0.1;
}
probability ( MaryCalls | Alarm ) {
  (Low) 0.2, 0.3, 0.5;
  (Medium) 0.4, 0.4, 0.2;
  (High) 0.6, 0.2, 0.2;
}